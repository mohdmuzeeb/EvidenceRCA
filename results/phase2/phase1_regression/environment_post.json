        },
        "mem_limit": "268435456",
        "networks": {
          "default": null
        },
        "restart": "no",
        "tmpfs": [
          "/var/lib/postgresql/data:size=128m"
        ],
        "volumes": [
          {
            "type": "bind",
            "source": "<repo>/testbed/postgres/init.sql",
            "target": "/docker-entrypoint-initdb.d/init.sql",
            "read_only": true,
            "bind": {
              "create_host_path": true
            }
          }
        ]
      }
    },
    "x-db-env": {
      "DATABASE_URL": "postgresql+psycopg://shop:<redacted>@postgres:5432/shop",
      "DB_POOL_SIZE": "5",
      "DB_POOL_TIMEOUT_S": "2.0"
    },
    "x-otel-env": {
      "DOWNSTREAM_RETRIES": "1",
      "DOWNSTREAM_TIMEOUT_S": "2.0",
      "OTEL_BLRP_SCHEDULE_DELAY": "1000",
      "OTEL_BSP_SCHEDULE_DELAY": "1000",
      "OTEL_EXPORTER_OTLP_ENDPOINT": "http://otel-collector:4318",
      "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
      "OTEL_METRIC_EXPORT_INTERVAL": "5000",
      "OTEL_SEMCONV_STABILITY_OPT_IN": "http,database"
    },
    "x-service": {
      "build": {
        "context": ".",
        "dockerfile": "testbed/Dockerfile"
      },
      "cpus": 1,
      "depends_on": {
        "otel-collector": {
          "condition": "service_started"
        }
      },
      "healthcheck": {
        "interval": "3s",
        "retries": 20,
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=2)"
        ],
        "timeout": "3s"
      },
      "image": "evidencerca-testbed:phase1",
      "mem_limit": "192m",
      "restart": "no"
    }
  },
  "vm": {
    "free_m": "total        used        free      shared  buff/cache   available\nMem:            2899         386        1701           0         953        2512\nSwap:              0           0           0",
    "df_root": "Filesystem      Size  Used Avail Use% Mounted on\n/dev/root        29G  1.9G   27G   7% /",
